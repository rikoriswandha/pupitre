{
  "name": "@rikology/pupitre-ui",
  "version": "0.1.0-beta.0",
  "description": "Default Pupitre catalog components built on shadcn/ui + Base UI",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": "Riko Riswandha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikoriswandha/pupitre.git",
    "directory": "packages/pupitre-ui"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build",
    "CHANGELOG.md",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": {
      "@rikology/source": "./src/index.ts",
      "types": "./build/src/index.d.ts",
      "default": "./build/src/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "quick:test": "node --conditions=@rikology/source --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test": "npm run quick:test",
    "compile": "npm run clean && tsdown && tsc -p tsconfig.build.json",
    "build": "npm run compile",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@rikology/pupitre": "^0.1.0-beta.0",
    "@rikology/pupitre-react": "^0.1.0-beta.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@playwright/test": "^1.62.1",
    "@poppinss/ts-exec": "^1.5.0",
    "@rikology/pupitre": "^0.1.0-beta.0",
    "@rikology/pupitre-react": "^0.1.0-beta.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "prettier": "@adonisjs/prettier-config"
}
