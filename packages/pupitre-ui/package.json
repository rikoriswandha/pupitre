{
  "name": "@rikology/pupitre-ui",
  "version": "1.1.1",
  "description": "Default Pupitre catalog components built on shadcn/ui + Base UI",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": "Riko Riswandha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikoriswandha/pupitre.git",
    "directory": "packages/pupitre-ui"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build",
    "registry",
    "README.md",
    "CHANGELOG.md",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": {
      "@rikology/source": "./src/index.ts",
      "types": "./build/src/index.d.ts",
      "default": "./build/src/index.js"
    },
    "./components": {
      "@rikology/source": "./src/components.ts",
      "types": "./build/src/components.d.ts",
      "default": "./build/src/components.js"
    },
    "./components/*": {
      "@rikology/source": "./src/components/*.tsx",
      "types": "./build/src/components/*.d.ts",
      "default": "./build/src/components/*.js"
    },
    "./testing": {
      "@rikology/source": "./src/testing.ts",
      "types": "./build/src/testing.d.ts",
      "default": "./build/src/testing.js"
    },
    "./styles.css": {
      "@rikology/source": "./src/styles.css",
      "default": "./build/src/styles.css"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ct.json",
    "quick:test": "node --conditions=@rikology/source --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test": "npm run quick:test && playwright test -c playwright-ct.config.ts",
    "compile": "npm run clean && tsdown && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/styles.css','build/src/styles.css')\"",
    "build": "npm run compile",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/source-serif-4": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "react-easy-crop": "^6.2.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@playwright/test": "^1.62.1",
    "@rikology/pupitre": "^1.1.0",
    "@rikology/pupitre-react": "^1.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@playwright/test": "^1.62.1",
    "@poppinss/ts-exec": "^1.5.0",
    "@rikology/pupitre": "^1.1.0",
    "@rikology/pupitre-react": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@adonisjs/prettier-config"
}
