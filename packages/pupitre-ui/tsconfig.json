{
  "extends": "@adonisjs/tsconfig/tsconfig.package.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "customConditions": [
      "@rikology/source"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "exclude": [
    "build",
    "node_modules",
    "tests/ct",
    "playwright",
    "playwright-ct.config.ts"
  ]
}
