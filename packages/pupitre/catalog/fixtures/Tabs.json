{
  "root": "root",
  "elements": {
    "root": {
      "type": "Tabs",
      "props": {
        "id": "content",
        "tabs": [
          {
            "key": "details",
            "label": "Details"
          },
          {
            "key": "media",
            "label": "Media"
          }
        ],
        "active": {
          "$bindState": "/ui/tabs/content"
        }
      },
      "children": [
        "tab"
      ]
    },
    "child": {
      "type": "Text",
      "props": {
        "name": "title",
        "label": "Title",
        "value": {
          "$bindState": "/data/title"
        }
      }
    },
    "tab": {
      "type": "Tab",
      "props": {
        "key": "details",
        "label": "Details"
      },
      "children": [
        "child"
      ]
    }
  },
  "state": {
    "data": {
      "title": "Example",
      "items": [
        {
          "sku": "ABC"
        }
      ]
    },
    "errors": {
      "title": "Required"
    }
  }
}
