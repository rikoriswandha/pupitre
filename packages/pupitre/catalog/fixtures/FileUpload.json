{
  "root": "root",
  "elements": {
    "root": {
      "type": "FileUpload",
      "props": {
        "name": "cover",
        "label": "Cover",
        "descriptor": {
          "name": "cover",
          "uploadUrl": "/upload",
          "deleteUrl": "/upload",
          "multiple": false,
          "image": true,
          "reorderable": false,
          "downloadable": true,
          "previewable": true
        },
        "value": {
          "$bindState": "/data/cover"
        }
      }
    }
  },
  "state": {
    "data": {
      "title": "Example",
      "items": [
        {
          "sku": "ABC"
        }
      ]
    },
    "errors": {
      "title": "Required"
    }
  }
}
