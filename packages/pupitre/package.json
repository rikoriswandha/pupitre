{
  "name": "@rikology/pupitre",
  "version": "0.2.0-beta.0",
  "description": "Filament-like admin panel for AdonisJS v7 + Inertia React, rendered through json-render specs",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Riko Riswandha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikoriswandha/pupitre.git",
    "directory": "packages/pupitre"
  },
  "homepage": "https://pupitre.dev",
  "keywords": [
    "adonisjs",
    "admin",
    "inertia",
    "json-render",
    "filament"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build",
    "CHANGELOG.md",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": {
      "@rikology/source": "./index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./catalog": {
      "@rikology/source": "./catalog/index.ts",
      "types": "./build/catalog/index.d.ts",
      "default": "./build/catalog/index.js"
    },
    "./types": {
      "@rikology/source": "./src/types.ts",
      "types": "./build/src/types.d.ts",
      "default": "./build/src/types.js"
    },
    "./pupitre_provider": {
      "@rikology/source": "./providers/pupitre_provider.ts",
      "types": "./build/providers/pupitre_provider.d.ts",
      "default": "./build/providers/pupitre_provider.js"
    },
    "./services/main": {
      "@rikology/source": "./services/main.ts",
      "types": "./build/services/main.d.ts",
      "default": "./build/services/main.js"
    },
    "./commands": {
      "@rikology/source": "./commands/main.ts",
      "types": "./build/commands/main.d.ts",
      "default": "./build/commands/main.js"
    },
    "./commands/*": {
      "@rikology/source": "./commands/*.ts",
      "types": "./build/commands/*.d.ts",
      "default": "./build/commands/*.js"
    },
    "./middleware/*": {
      "@rikology/source": "./src/http/middleware/*.ts",
      "types": "./build/src/http/middleware/*.d.ts",
      "default": "./build/src/http/middleware/*.js"
    },
    "./hooks": {
      "@rikology/source": "./src/discovery/index_admin.ts",
      "types": "./build/src/discovery/index_admin.d.ts",
      "default": "./build/src/discovery/index_admin.js"
    },
    "./drivers/*": {
      "@rikology/source": "./src/drivers/*.ts",
      "types": "./build/src/drivers/*.d.ts",
      "default": "./build/src/drivers/*.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "quick:test": "node --conditions=@rikology/source --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test": "c8 npm run quick:test",
    "compile": "npm run clean && tsdown && tsc -p tsconfig.build.json",
    "postcompile": "copyfiles \"stubs/**/*.stub\" build && copyfiles \"commands/commands.json\" build && node --import=@poppinss/ts-exec scripts/generate_commands_manifest.ts",
    "build": "npm run compile",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@json-render/core": "0.21.0",
    "acorn": "^8.19.0",
    "file-type": "^22.1.1",
    "sanitize-html": "^2.18.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/inertia": "^5.0.0",
    "@adonisjs/limiter": "^3.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/session": "^8.0.0",
    "@rikology/adonisjs-notifications": "^1.5.0",
    "@rikology/adonisjs-tenant": "^1.0.0",
    "@vinejs/vine": "^4.0.0",
    "luxon": "^3.4.4"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/auth": {
      "optional": true
    },
    "@adonisjs/bouncer": {
      "optional": true
    },
    "@adonisjs/drive": {
      "optional": true
    },
    "@adonisjs/limiter": {
      "optional": true
    },
    "@adonisjs/mail": {
      "optional": true
    },
    "@rikology/adonisjs-notifications": {
      "optional": true
    },
    "@rikology/adonisjs-tenant": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.1",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@japa/snapshot": "^2.0.10",
    "@poppinss/ts-exec": "^1.5.0",
    "@rikology/adonisjs-notifications": "^1.5.2",
    "@rikology/adonisjs-tenant": "^1.0.2",
    "@types/luxon": "^3.7.1",
    "@types/sanitize-html": "^2.16.2",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^13.0.3",
    "c8": "^12.0.0",
    "copyfiles": "^2.4.1",
    "flydrive": "^2.2.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "tsdown": "^0.23.0"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "include": [
      "src/**",
      "catalog/**"
    ],
    "exclude": [
      "tests/**",
      "bin/**"
    ]
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "prettier": "@adonisjs/prettier-config"
}
