import { definePanel } from '@rikology/pupitre'
import { resources } from '#generated/admin'
import { middleware } from '#start/kernel'

export default definePanel('{{panel}}')
  .path('{{path}}')
  .guard('{{auth}}')
  .middleware([middleware.auth({ guards: ['{{auth}}'] })])
  .resources(resources)
