{
  "name": "@rikology/create-pupitre-plugin",
  "version": "1.0.0",
  "description": "Scaffold a Pupitre plugin package (npm create @rikology/pupitre-plugin)",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Riko Riswandha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikoriswandha/pupitre.git",
    "directory": "packages/create-pupitre-plugin"
  },
  "homepage": "https://pupitre.rikology.com",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build",
    "template",
    "template-ui",
    "CHANGELOG.md",
    "!build/tests"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "adonisjs",
    "pupitre",
    "pupitre-plugin",
    "scaffold",
    "create"
  ],
  "bin": {
    "create-pupitre-plugin": "./build/bin/create.js"
  },
  "exports": {
    ".": {
      "@rikology/source": "./index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "quick:test": "node --conditions=@rikology/source --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test": "c8 npm run quick:test",
    "compile": "npm run clean && tsdown && tsc -p tsconfig.build.json",
    "build": "npm run compile",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@japa/file-system": "^3.0.0",
    "@poppinss/ts-exec": "^1.5.0",
    "c8": "^12.0.0",
    "tsdown": "^0.23.0"
  },
  "prettier": "@adonisjs/prettier-config"
}
