{
  "name": "{{packageName}}",
  "version": "0.1.0",
  "description": "{{name}} UI plugin for Pupitre",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build",
    "CHANGELOG.md",
    "!build/tests",
    "!build/bin"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./catalog": {
      "types": "./build/catalog.d.ts",
      "default": "./build/catalog.js"
    },
    "./react": {
      "types": "./build/react.d.ts",
      "default": "./build/react.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "quick:test": "node --import=@poppinss/ts-exec bin/test.ts",
    "test": "npm run typecheck && npm run quick:test",
    "build": "tsdown && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@rikology/pupitre": "^1.1.0",
    "@rikology/pupitre-react": "^1.1.0",
    "@vinejs/vine": "^4.4.0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@rikology/pupitre": "^1.1.0",
    "@rikology/pupitre-react": "^1.1.0",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@vinejs/vine": "^4.4.0",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.0",
    "zod": "^4.0.0"
  }
}
