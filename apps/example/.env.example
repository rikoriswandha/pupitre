# Node
TZ=UTC
PORT=3391
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Optional social login (set a provider's full credential pair to expose it).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development/e2e only: enable the local fake Ally driver.
PUPITRE_FAKE_ALLY=false

# Session
SESSION_DRIVER=cookie